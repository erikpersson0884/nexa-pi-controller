# Copy this file to .env and replace the placeholder values.

SECRET_KEY=replace-with-a-long-random-secret
AUTH_USERNAME=admin
AUTH_PASSWORD=choose-a-long-unique-password

# GPIO configuration
GPIO_CHIP=15
TX_PIN=17
RX_PIN=27

# Application settings
HOST=0.0.0.0
PORT=8080
TZ=Europe/Stockholm
DATA_DIR=./data
COOKIE_SECURE=false
GPIO_MODE=hardware

# Docker Compose uses these optional settings when provided:
# AUTH_PASSWORD_HASH=
# AUTH_PASSWORD_HASH_B64=
# AUTH_PASSWORD_HASH_FILE=
